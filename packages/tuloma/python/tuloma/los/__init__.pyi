from typing import Literal, overload
import numpy as np
from numpy.typing import NDArray

Point2 = tuple[float, float]
FloatArray = NDArray[np.float64]
ALGORITHMS_IMPLEMENTED: bool

class Location:
    Above: Location
    On: Location
    Below: Location

class Visibility:
    Visible: Visibility
    Touch: Visibility
    Blocked: Visibility
    SameX: Visibility

class ContactKind:
    Enter: ContactKind  # uint8 code 1
    Exit: ContactKind  # uint8 code 2
    Touch: ContactKind  # uint8 code 3

class ClearanceExtrema:
    @property
    def min_value(self) -> float: ...
    @property
    def max_value(self) -> float: ...
    @property
    def min_point(self) -> Point2: ...
    @property
    def max_point(self) -> Point2: ...
    @property
    def min_parameter(self) -> float: ...
    @property
    def max_parameter(self) -> float: ...

class ClearanceProfile:
    @property
    def parameters(self) -> FloatArray: ...
    @property
    def clearance(self) -> FloatArray: ...

class Contacts:
    @property
    def points(self) -> FloatArray: ...
    @property
    def parameters(self) -> FloatArray: ...
    @property
    def kinds(self) -> NDArray[np.uint8]: ...
    @property
    def overlaps(self) -> FloatArray: ...

class Scene1D:
    def __init__(self, x: FloatArray, z: FloatArray) -> None: ...
    @staticmethod
    def from_numpy(x: FloatArray, z: FloatArray) -> Scene1D: ...
    @staticmethod
    def from_uniform(z: FloatArray, *, x0: float = 0.0, dx: float = 1.0) -> Scene1D: ...
    @property
    def x(self) -> FloatArray: ...
    @property
    def z(self) -> FloatArray: ...
    def __len__(self) -> int: ...
    def validate(self) -> None: ...
    @overload
    def height(self, xq: float, *, out: None = None) -> float: ...
    @overload
    def height(self, xq: FloatArray, *, out: FloatArray | None = None) -> FloatArray: ...
    def point(self, x: float, *, agl: float = 0.0) -> Point2: ...
    def node_range(self, xa: float, xb: float, *, interior: bool = True) -> tuple[int, int]: ...
    def locate(self, point: Point2, *, atol: float = 0.0) -> Location: ...
    def visible(self, a: Point2, b: Point2, *, touch: Literal["allow", "block"] = "allow", atol: float = 0.0) -> bool: ...
    def classify(self, a: Point2, b: Point2, *, atol: float = 0.0) -> Visibility: ...
    @overload
    def clearance_at(self, a: Point2, b: Point2, xq: float, *, out: None = None) -> float: ...
    @overload
    def clearance_at(self, a: Point2, b: Point2, xq: FloatArray, *, out: FloatArray | None = None) -> FloatArray: ...
    def clearance_profile(self, a: Point2, b: Point2) -> ClearanceProfile: ...
    def clearance_extrema(self, a: Point2, b: Point2) -> ClearanceExtrema: ...
    def intersections(self, a: Point2, b: Point2, *, endpoints: bool = False) -> Contacts: ...
    def below_intervals(self, a: Point2, b: Point2) -> FloatArray: ...
    def first_intersection(self, a: Point2, b: Point2, *, endpoints: bool = False) -> Point2 | None: ...

@overload
def lerp(left: float, right: float, t: float, *, out: None = None) -> float: ...
@overload
def lerp(left: float, right: float, t: FloatArray, *, out: FloatArray | None = None) -> FloatArray: ...
@overload
def line_height(a: Point2, b: Point2, xq: float, *, out: None = None) -> float: ...
@overload
def line_height(a: Point2, b: Point2, xq: FloatArray, *, out: FloatArray | None = None) -> FloatArray: ...
@overload
def segment_points(a: Point2, b: Point2, t: float, *, out: None = None) -> Point2: ...
@overload
def segment_points(a: Point2, b: Point2, t: FloatArray, *, out: FloatArray | None = None) -> FloatArray: ...
